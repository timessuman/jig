{
  "name": "jig-ui",
  "version": "0.1.0",
  "description": "A design system for coding agents. 104 numbered UI rules, brand x mode design tokens, and an installer for Claude Code, Codex, Cursor and opencode.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "jig": "./dist/index.js"
  },
  "files": [
    "dist",
    "rules",
    "tokens",
    "templates",
    "rules.index.json",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build && node scripts/stage-assets.mjs"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "ai-agents",
    "claude-code",
    "codex",
    "cursor",
    "opencode",
    "ui",
    "accessibility",
    "css"
  ],
  "author": "timessuman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timessuman/jig.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/timessuman/jig#readme",
  "bugs": {
    "url": "https://github.com/timessuman/jig/issues"
  }
}
