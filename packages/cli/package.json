{
  "name": "jig-ui",
  "version": "0.1.0",
  "description": "A design system for coding agents. Rules, tokens, and a linter.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": { "jig": "./dist/index.js" },
  "files": ["dist", "rules", "tokens", "templates", "rules.index.json", "LICENSE", "NOTICE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
